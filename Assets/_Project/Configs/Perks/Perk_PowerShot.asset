  _displayName: "\u041C\u043E\u0449\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0440\u0435\u043B"
  _description: "\u0420\u0430\u0437 \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0441\u0435\u043A\u0443\u043D\u0434 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
    \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u0437\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F
    \u0434\u043E\u043B\u044C\u0448\u0435, \u0431\u044C\u0451\u0442 \u0441\u0438\u043B\u044C\u043D\u0435\u0435
    \u0438 \u0441 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u044B\u043C \u0448\u0430\u043D\u0441\u043E\u043C
    \u043A\u0440\u0438\u0442\u0430, \u0430 \u0441\u0442\u0440\u0435\u043B\u0430 \u0432\u0434\u0432\u043E\u0435
    \u0448\u0438\u0440\u0435 \u0438 \u043F\u0440\u043E\u043D\u0437\u0430\u0435\u0442
    \u0432\u0441\u0435\u0445 \u0432\u0440\u0430\u0433\u043E\u0432 \u043D\u0430 \u043F\u0443\u0442\u0438."
