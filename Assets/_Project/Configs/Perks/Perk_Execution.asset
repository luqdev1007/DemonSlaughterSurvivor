  m_Name: Perk_Execution
  m_EditorClassIdentifier: Game.Configs::Game.Configs.PerkConfig
  _id: perk.execution
  _displayName: "\u041A\u0430\u0437\u043D\u044C"
  _description: "\u0412\u0440\u0430\u0433 \u043F\u0435\u0440\u0435\u0434 \u0433\u0435\u0440\u043E\u0435\u043C
    \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445 \u0443\u0434\u0430\u0440\u0430,
    \u0443 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
    \u043C\u0435\u043D\u044C\u0448\u0435 30% \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F,
    \u0434\u043E\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0441 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
    \u0443\u0434\u0430\u0440\u0430; \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430
    10\u20136 \u0441. \u0411\u043E\u0441\u0441\u0430 \u043A\u0430\u0437\u043D\u044C
    \u0431\u044C\u0451\u0442 \u0442\u0440\u0435\u043C\u044F \u0443\u0434\u0430\u0440\u0430\u043C\u0438
    \u043F\u043E 3\u20135% \u0435\u0433\u043E \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F + 20\u201340, \u043D\u0438\u0436\u0435
    30% \u2014 \u0443\u0440\u043E\u043D \u0432\u0434\u0432\u043E\u0435; \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430
    20\u201312 \u0441. \u0411\u043E\u0441\u0441 \u0432 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u0435."
