  _displayName: "\u0422\u043E\u0440\u043D\u0430\u0434\u043E"
  _description: "\u0420\u0430\u0437 \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0441\u0435\u043A\u0443\u043D\u0434 \u043E\u0442 \u043A\u043E\u043B\u0434\u0443\u043D\u0430
    \u0441\u0430\u043C\u0438 \u0441\u043E\u0431\u043E\u0439 \u043E\u0442\u0445\u043E\u0434\u044F\u0442
    \u0432\u0438\u0445\u0440\u0438 \u0442\u043E\u0440\u043D\u0430\u0434\u043E. \u041E\u043D\u0438
    \u043F\u0435\u0442\u043B\u044F\u044E\u0442 \u0437\u0438\u0433\u0437\u0430\u0433\u0430\u043C\u0438,
    \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438 \u0440\u0430\u043D\u044F\u0442
    \u0432\u0441\u0435\u0445 \u0437\u0430\u0434\u0435\u0442\u044B\u0445 \u0432\u0440\u0430\u0433\u043E\u0432
    \u043C\u0430\u0433\u0438\u0435\u0439 \u043F\u0440\u0438\u0440\u043E\u0434\u044B
    \u0438 \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044E\u0442 \u0438\u0445."
