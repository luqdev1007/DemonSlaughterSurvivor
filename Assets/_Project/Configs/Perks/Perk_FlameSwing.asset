  _displayName: "\u041F\u043B\u0430\u043C\u0435\u043D\u043D\u044B\u0439 \u0437\u0430\u043C\u0430\u0445"
  _description: "\u0420\u0430\u0437 \u0432 8\u20136 \u0441, \u0435\u0441\u043B\u0438
    \u0441\u0442\u043E\u044F\u0442\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
    (\u041F\u041A\u041C) \u0438 \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u0432\u0440\u0430\u0433\u0438,
    \u0431\u0435\u0440\u0441\u0435\u0440\u043A \u0434\u0435\u043B\u0430\u0435\u0442
    \u0440\u0430\u0437\u043C\u0430\u0448\u0438\u0441\u0442\u044B\u0439 \u0432\u044B\u043F\u0430\u0434:
    \u043F\u043E \u0437\u0435\u043C\u043B\u0435 \u043F\u043E\u043B\u0437\u0451\u0442
    \u0434\u0443\u0433\u0430 \u043E\u0433\u043D\u0435\u043D\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u044B
    \u043D\u0430 8\u201310 \u043C \u0438 \u043E\u0431\u0436\u0438\u0433\u0430\u0435\u0442
    \u0432\u0441\u0435\u0445 \u043D\u0430 \u043F\u0443\u0442\u0438 \u043D\u0430 150\u2013250%
    \u0443\u0440\u043E\u043D\u0430 \u043C\u0435\u0447\u0430."
