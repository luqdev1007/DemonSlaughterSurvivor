  _displayName: "\u0412\u0440\u0430\u0449\u0430\u044E\u0449\u0438\u0439\u0441\u044F
    \u0447\u0430\u043A\u0440\u0430\u043C"
  _description: "\u041A\u0430\u0436\u0434\u044B\u0435 7\u20135 \u0441 \u043E\u0442
    \u043E\u0445\u043E\u0442\u043D\u0438\u0446\u044B \u043F\u043E \u0440\u0430\u0441\u043A\u0440\u0443\u0447\u0438\u0432\u0430\u044E\u0449\u0435\u0439\u0441\u044F
    \u0441\u043F\u0438\u0440\u0430\u043B\u0438 \u0432\u044B\u043B\u0435\u0442\u0430\u0435\u0442
    \u0447\u0430\u043A\u0440\u0430\u043C. \u041E\u043D \u0440\u0435\u0436\u0435\u0442
    \u0432\u0441\u0435\u0445 \u0432\u0440\u0430\u0433\u043E\u0432 \u043D\u0430 \u043F\u0443\u0442\u0438:
    120\u2013180% \u0443\u0440\u043E\u043D\u0430 \u043B\u0443\u043A\u0430, \u0437\u0430\u043C\u0435\u0434\u043B\u0435\u043D\u0438\u0435
    \u043D\u0430 35% \u043D\u0430 2 \u0441 \u0438 \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0435\u043D\u0438\u0435
    35\u201355% \u0443\u0440\u043E\u043D\u0430 \u043B\u0443\u043A\u0430 \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443
    \u043D\u0430 3\u20134 \u0441. \u041D\u0430 3-\u043C \u0443\u0440\u043E\u0432\u043D\u0435
    \u0447\u0430\u043A\u0440\u0430\u043C\u043E\u0432 \u0434\u0432\u0430."
