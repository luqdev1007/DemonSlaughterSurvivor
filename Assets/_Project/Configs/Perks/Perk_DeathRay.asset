  m_Name: Perk_DeathRay
  m_EditorClassIdentifier: Game.Configs::Game.Configs.PerkConfig
  _id: perk.death-ray
  _displayName: "\u041B\u0443\u0447 \u0441\u043C\u0435\u0440\u0442\u0438"
  _description: "\u0417\u0430\u0436\u043C\u0438\u0442\u0435 \u041F\u041A\u041C \u0438
    \u0441\u0442\u043E\u0439\u0442\u0435 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435:
    \u043A\u043E\u043B\u0434\u0443\u043D \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442
    \u044D\u043D\u0435\u0440\u0433\u0438\u044E \u0432 \u043B\u0430\u0434\u043E\u043D\u044F\u0445
    \u0438 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0439
    \u043B\u0443\u0447 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043A\u0443\u0440\u0441\u043E\u0440\u0430.
    \u041B\u0443\u0447 \u043F\u0440\u043E\u0436\u0438\u0433\u0430\u0435\u0442 \u0432\u0441\u0451
    \u043D\u0430 \u0441\u0432\u043E\u0451\u043C \u043F\u0443\u0442\u0438, \u043F\u043E\u043A\u0430
    \u043A\u043D\u043E\u043F\u043A\u0430 \u0437\u0430\u0436\u0430\u0442\u0430 (\u0434\u043E
    3 \u0441); \u0448\u0430\u0433 \u0438\u043B\u0438 \u043E\u0442\u043F\u0443\u0449\u0435\u043D\u043D\u0430\u044F
    \u043A\u043D\u043E\u043F\u043A\u0430 \u0433\u0430\u0441\u044F\u0442 \u0435\u0433\u043E."
