  _displayName: "\u0421\u0442\u0440\u0435\u043B\u0430 \u043C\u043E\u043B\u043D\u0438\u0438"
  _description: "\u0420\u0430\u0437 \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0441\u0435\u043A\u0443\u043D\u0434 \u043E\u0434\u043D\u0430 \u0438\u0437 \u0432\u044B\u043F\u0443\u0449\u0435\u043D\u043D\u044B\u0445
    \u0441\u0442\u0440\u0435\u043B \u0437\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F
    \u043C\u043E\u043B\u043D\u0438\u0435\u0439. \u041F\u043E\u043F\u0430\u0432 \u0432\u043E
    \u0432\u0440\u0430\u0433\u0430, \u043E\u043D\u0430 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442
    \u0446\u0435\u043F\u043D\u0443\u044E \u043C\u043E\u043B\u043D\u0438\u044E, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043F\u0435\u0440\u0435\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442
    \u043D\u0430 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0445 \u0432\u0440\u0430\u0433\u043E\u0432."
