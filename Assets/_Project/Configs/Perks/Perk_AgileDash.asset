  _id: perk.agile-dash
  _displayName: "\u041B\u043E\u0432\u043A\u0438\u0439 \u0440\u044B\u0432\u043E\u043A"
  _description: "\u0415\u0441\u043B\u0438 \u0432 \u043A\u043E\u043D\u0446\u0435 \u0440\u044B\u0432\u043A\u0430
    \u0440\u044F\u0434\u043E\u043C \u0432\u0440\u0430\u0433\u0438 \u2014 \u0441\u0440\u0430\u0437\u0443
    \u0443\u0434\u0430\u0440 \u0432\u043E\u043A\u0440\u0443\u0433 (\u0434\u0432\u0430\u2013\u0442\u0440\u0438
    \u0441 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043E\u0439 \u0443\u0440\u043E\u043D\u0430
    \u043C\u0435\u0447\u0430) \u0441 \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u0435\u043C;
    \u043D\u0430 \u0432\u0437\u043C\u0430\u0445 \u0433\u0435\u0440\u043E\u0439 \u043D\u0435\u0443\u044F\u0437\u0432\u0438\u043C,
    \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435 \u0441\u043D\u0430\u0440\u044F\u0434\u044B
    \u043F\u0440\u043E\u043B\u0435\u0442\u0430\u044E\u0442 \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C.
    \u041F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430 8\u20135 \u0441.
    \u0417\u0430\u0440\u044F\u0434 \u0440\u044B\u0432\u043A\u0430 \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442
    \u0443\u0434\u0430\u0440."
