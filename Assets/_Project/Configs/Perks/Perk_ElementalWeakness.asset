  _id: perk.elemental-weakness
  _displayName: "\u0421\u0442\u0438\u0445\u0438\u0439\u043D\u0430\u044F \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u044C"
  _description: "\u0421\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0435 \u0432\u0440\u0430\u0433\u0438
    \u043F\u043E\u0431\u043B\u0438\u0437\u043E\u0441\u0442\u0438 \u043F\u043E\u043C\u0435\u0447\u0430\u044E\u0442\u0441\u044F
    \u0441\u0442\u0438\u0445\u0438\u0435\u0439: \u043E\u0433\u043E\u043D\u044C, \u043B\u0451\u0434
    \u0438\u043B\u0438 \u0442\u0430\u0439\u043D\u0430\u044F \u043C\u0430\u0433\u0438\u044F.
    \u0423\u0440\u043E\u043D \u044D\u0442\u043E\u0439 \u0441\u0442\u0438\u0445\u0438\u0435\u0439
    \u043F\u043E \u043F\u043E\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u043C\u0443
    \u0432\u0440\u0430\u0433\u0443 \u0443\u0441\u0438\u043B\u0435\u043D, \u0430 \u0435\u0441\u043B\u0438
    \u043E\u043D \u0435\u0433\u043E \u0434\u043E\u0431\u0438\u0432\u0430\u0435\u0442
    \u2014 \u0432\u0440\u0430\u0433 \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
    \u0440\u0430\u043D\u044F \u0432\u0441\u0435\u0445 \u0440\u044F\u0434\u043E\u043C
    \u0442\u043E\u0439 \u0436\u0435 \u0441\u0442\u0438\u0445\u0438\u0435\u0439."
