  m_Name: Perk_Execution
  m_EditorClassIdentifier: Game.Configs::Game.Configs.PerkConfig
  _id: perk.execution
  _displayName: "\u041A\u0430\u0437\u043D\u044C"
  _description: "\u042D\u043B\u0438\u0442\u043D\u044B\u0439 \u0432\u0440\u0430\u0433
    \u0438\u043B\u0438 \u0431\u043E\u0441\u0441 \u043F\u0435\u0440\u0435\u0434 \u0433\u0435\u0440\u043E\u0435\u043C
    \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0441\u0435\u0440\u0438\u044E
    \u0438\u0437 \u0442\u0440\u0451\u0445 \u0443\u0434\u0430\u0440\u043E\u0432: \u0434\u043E\u043B\u044F
    \u0435\u0433\u043E \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
    \u043F\u043B\u044E\u0441 \u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0443\u0440\u043E\u043D, \u043D\u0438\u0436\u0435 30% \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
    \u2014 \u0432\u0434\u0432\u043E\u0435. \u0411\u043E\u0441\u0441 \u0432 \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u0435.
    \u041F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430 20\u201312
    \u0441, \u043F\u043E \u044D\u043B\u0438\u0442\u043A\u0435 \u2014 \u0432\u0434\u0432\u043E\u0435
    \u043A\u043E\u0440\u043E\u0447\u0435. \u041E\u0431\u044B\u0447\u043D\u044B\u0445
    \u0432\u0440\u0430\u0433\u043E\u0432 \u043A\u0430\u0437\u043D\u044C \u043D\u0435
    \u0442\u0440\u043E\u0433\u0430\u0435\u0442."
