  _id: perk.arcane-wave
  _displayName: "\u0412\u043E\u043B\u043D\u0430 \u0430\u0440\u043A\u0430\u043D"
  _description: "\u0420\u0430\u0437 \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0441\u0435\u043A\u0443\u043D\u0434 \u043E\u0442 \u043A\u043E\u043B\u0434\u0443\u043D\u0430
    \u0441\u0430\u043C\u0430 \u0441\u043E\u0431\u043E\u0439 \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0441\u0438\u043D\u0435-\u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u0430\u044F
    \u0432\u043E\u043B\u043D\u0430 \u0442\u0430\u0439\u043D\u043E\u0439 \u043C\u0430\u0433\u0438\u0438:
    \u0440\u0430\u043D\u0438\u0442 \u0438 \u0441\u043B\u0435\u0433\u043A\u0430 \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
    \u0432\u0440\u0430\u0433\u043E\u0432. \u0412\u0440\u0430\u0433\u0438 \u043F\u043E\u0434
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u043B\u044E\u0431\u043E\u0439
    \u0441\u0442\u0438\u0445\u0438\u0438 (\u0433\u043E\u0440\u044F\u0442, \u0437\u0430\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u044B,
    \u0437\u0430\u043C\u0435\u0434\u043B\u0435\u043D\u044B, \u043F\u043E\u043C\u0435\u0447\u0435\u043D\u044B)
    \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u043E\u0442 \u043D\u0435\u0451
    \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u044B\u0439 \u0443\u0440\u043E\u043D."
