  _id: perk.punishing-leap
  _displayName: "\u041A\u0430\u0440\u0430\u044E\u0449\u0438\u0439 \u043F\u0440\u044B\u0436\u043E\u043A"
  _description: "\u041F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u0435 \u0433\u0435\u0440\u043E\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u043F\u0440\u044B\u0436\u043A\u0430 \u0434\u043E\u0431\u0438\u0432\u0430\u0435\u0442 \u0432\u0441\u0435\u0445 \u0437\u0430\u0434\u0435\u0442\u044B\u0445 \u0432\u0440\u0430\u0433\u043E\u0432, \u0443 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043C\u0435\u043D\u044C\u0448\u0435 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F, \u0430 \u0435\u0441\u043B\u0438 \u0442\u0430\u043A\u0438\u0445 \u043D\u0435\u0442 \u2014 \u0441\u0430\u043C\u043E\u0433\u043E \u0440\u0430\u043D\u0435\u043D\u043E\u0433\u043E \u0438\u0437 \u0437\u0430\u0434\u0435\u0442\u044B\u0445. \u0421\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u0432\u0441\u0435\u0433\u0434\u0430, \u043A\u043E\u0433\u0434\u0430 \u0433\u043E\u0442\u043E\u0432\u044B \u0438 \u043E\u043D, \u0438 \u00AB\u041A\u0430\u0437\u043D\u044C\u00BB. \u041F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430 7\u20134 \u0441. \u0411\u043E\u0441\u0441\u0430 \u043D\u0435 \u0434\u043E\u0431\u0438\u0432\u0430\u0435\u0442. \u0422\u0440\u0435\u0431\u0443\u0435\u0442 \u00AB\u0413\u0435\u0440\u043E\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u044B\u0436\u043E\u043A\u00BB \u0438 \u00AB\u041A\u0430\u0437\u043D\u044C\u00BB."
