  m_Name: Perk_SlicingDash
  m_EditorClassIdentifier: Game.Configs::Game.Configs.PerkConfig
  _id: perk.slicing-dash
  _displayName: "\u0420\u0435\u0436\u0443\u0449\u0438\u0439 \u0440\u044B\u0432\u043E\u043A"
  _description: "\u0420\u044B\u0432\u043E\u043A \u0441 \u0448\u0430\u043D\u0441\u043E\u043C
    30\u201360% \u0440\u0435\u0436\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432
    \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043C\u0435\u0447\u0430
    (\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430\u2013\u0434\u0435\u0432\u044F\u0442\u044C
    \u0434\u0435\u0441\u044F\u0442\u044B\u0445 \u0443\u0440\u043E\u043D\u0430 \u043C\u0435\u0447\u0430)
    \u0438 \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u0438\u0445
    \u0432\u0431\u043E\u043A, \u0430 \u0432 \u043A\u043E\u043D\u0446\u0435 \u2014
    \u0440\u0430\u0437\u043C\u0430\u0448\u0438\u0441\u0442\u044B\u0439 \u0443\u0434\u0430\u0440
    (\u043F\u043E\u043B\u0442\u043E\u0440\u0430\u2013\u0434\u0432\u0430 \u0441 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043E\u0439
    \u0443\u0440\u043E\u043D\u0430 \u043C\u0435\u0447\u0430). \u0417\u0430\u0440\u044F\u0434
    \u0440\u044B\u0432\u043A\u0430 \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442
    \u043E\u0431\u0430 \u0443\u0434\u0430\u0440\u0430."
