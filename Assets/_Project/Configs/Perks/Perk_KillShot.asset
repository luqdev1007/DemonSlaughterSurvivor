  m_Name: Perk_KillShot
  m_EditorClassIdentifier: Game.Configs::Game.Configs.PerkConfig
  _id: perk.kill-shot
  _displayName: "\u0423\u0431\u0438\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u0432\u044B\u0441\u0442\u0440\u0435\u043B"
  _description: "\u0421\u0442\u043E\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
    (\u041F\u041A\u041C), \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0442\u0435
    \u043F\u0440\u0438\u0446\u0435\u043B \u043D\u0430 \u044D\u043B\u0438\u0442\u043D\u043E\u043C
    \u0432\u0440\u0430\u0433\u0435 \u0438\u043B\u0438 \u0431\u043E\u0441\u0441\u0435
    \u0434\u043E\u043B\u044C\u0448\u0435 0.2 \u0441 \u2014 \u043E\u0445\u043E\u0442\u043D\u0438\u0446\u0430
    \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0430\u043B\u0443\u044E
    \u043A\u043E\u043C\u0435\u0442\u0443. \u041E\u043D\u0430 \u043F\u0440\u043E\u043D\u0437\u0430\u0435\u0442
    \u0432\u0441\u0435\u0445 \u043D\u0430 \u043F\u0443\u0442\u0438 (150\u2013250%
    \u0443\u0440\u043E\u043D\u0430 \u043B\u0443\u043A\u0430) \u0438 \u0431\u044C\u0451\u0442
    \u0446\u0435\u043B\u044C \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C
    \u043A\u0440\u0438\u0442\u043E\u043C (400\u2013600% \u0443\u0440\u043E\u043D\u0430
    \u043B\u0443\u043A\u0430): \u044D\u043B\u0438\u0442\u0443 \u0441 \u0437\u0430\u043F\u0430\u0441\u043E\u043C
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u043D\u0438\u0436\u0435 25\u201335%
    \u0434\u043E\u0431\u0438\u0432\u0430\u0435\u0442 \u0441\u0440\u0430\u0437\u0443,
    \u0431\u043E\u0441\u0441\u0443 \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0434\u0432\u043E\u0439\u043D\u043E\u0439
    \u043A\u0440\u0438\u0442. \u041F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430
    14\u201310 \u0441."
